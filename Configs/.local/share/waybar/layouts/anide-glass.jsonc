{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "output": ["*"],
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": ["$XDG_CONFIG_HOME/waybar/includes/includes.json"],

  "modules-left": ["group/pill#navigation"],
  "modules-center": ["group/pill#center"],
  "modules-right": ["group/pill#system"],

  "group/pill#navigation": {
    "orientation": "inherit",
    "modules": ["custom/anide-launcher", "hyprland/workspaces"]
  },
  "group/pill#center": {
    "orientation": "inherit",
    "modules": ["mpris", "clock"]
  },
  "group/pill#system": {
    "orientation": "inherit",
    "modules": ["custom/anide-theme", "custom/anide-wallpaper", "custom/anide-keybinds", "custom/anide-settings", "privacy", "tray", "network", "pulseaudio", "battery"]
  },

  "custom/anide-launcher": {
    "format": "",
    "tooltip-format": "Mở ứng dụng",
    "on-click": "hyde-shell rofilaunch d -click-to-exit"
  },
  "custom/anide-theme": {
    "format": "",
    "tooltip-format": "Chọn theme",
    "on-click": "hyde-shell app -t scope -- theme.select.sh"
  },
  "custom/anide-wallpaper": {
    "format": "󰋩",
    "tooltip-format": "Chọn hình nền",
    "on-click": "hyde-shell app -t scope -- wallpaper.sh --select --global"
  },
  "custom/anide-keybinds": {
    "format": "",
    "tooltip-format": "Phím tắt",
    "on-click": "hyde-shell keybinds_hint"
  },
  "custom/anide-settings": {
    "format": "⚙",
    "tooltip-format": "AniDE Settings",
    "on-click": "hyde-shell anide-settings"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "player-icons": {"default": "▶"},
    "status-icons": {"paused": "Ⅱ"},
    "dynamic-separator": " · ",
    "max-length": 24,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
